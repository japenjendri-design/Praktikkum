def Aliansi(x: dict):

    # cek apakah koala ada
    if "koala" not in [k.lower() for k in x.keys()]:
        print("Koala Tidak Ada")
        return

    # gabungkan semua key koala (case-insensitive)
    koala_list = []

    for k, v in x.items():
        if k.lower() == "koala":
            koala_list.extend(v)

    koala_set = set(koala_list)

    # cari pihak netral
    semua_list = []

    for v in x.values():
        semua_list.append(set(v))

    if semua_list:
        netral = set.intersection(*semua_list)
    else:
        netral = set()

    # cari aliansi koala murni
    selain_koala = set()

    for k, v in x.items():
        if k.lower() != "koala":
            selain_koala.update(v)

    murni = koala_set - selain_koala

    # output
    print("Pihak Netral:", ", ".join(netral))
    print("Aliansi Koala Murni:", ", ".join(murni))
