# gerbang.py

def pecahkan_gerbang(daftar_prasasti):
    n = daftar_prasasti[0]

    prasasti = []

    for i in range(1, n + 1):
        kata = set(daftar_prasasti[i].split())
        prasasti.append(kata)

    # Mantra Super = ada di semua prasasti
    mantra_super = prasasti[0]

    for s in prasasti[1:]:
        mantra_super = mantra_super.intersection(s)

    # Mantra Eksklusif = hanya ada di prasasti pertama
    gabungan_lain = set()

    for s in prasasti[1:]:
        gabungan_lain = gabungan_lain.union(s)

    mantra_eksklusif = prasasti[0].difference(gabungan_lain)

    # Output
    if mantra_super:
        print(*sorted(mantra_super))
    else:
        print("TIDAK ADA")

    if mantra_eksklusif:
        print(*sorted(mantra_eksklusif))
    else:
        print("TIDAK ADA")
